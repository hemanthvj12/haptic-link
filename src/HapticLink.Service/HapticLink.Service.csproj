<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The HapticLink service (LocalSystem): finds a DualSense connected over Bluetooth, gives games a virtual wired one,
    relays games' output, haptics and speaker sound back, hides the real pad from games. Also the one-time setup and removal.
    Its <Version> is the service's own: the app re-runs setup (one admin prompt) only when the bundled service is newer
    than the installed one, so bump it when the service, driver or helper change.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HapticLink.Service</RootNamespace>
    <AssemblyName>HapticLink.Service</AssemblyName>
    <!-- Task Manager's Processes list shows the exe's description and icon: "HapticLink service" with the app's logo,
         next to the tray's "HapticLink" (a service can't be grouped under the tray: Windows starts it). -->
    <AssemblyTitle>HapticLink service</AssemblyTitle>
    <Product>HapticLink for DualSense</Product>
    <ApplicationIcon>..\HapticLink.Shared\Assets\app.ico</ApplicationIcon>
    <Version>1.3.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HapticLink.Tests" />
  </ItemGroup>

</Project>
