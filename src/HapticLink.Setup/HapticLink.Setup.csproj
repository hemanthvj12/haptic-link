<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HapticLink.Setup.exe: the setup window (WinForms). The tray (HapticLink.exe, src\HapticLink.Tray) starts it only when
    it's needed and it exits when closed, so WinForms isn't kept in memory. Shares src\HapticLink.Shared with the tray.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HapticLink.App</RootNamespace>
    <AssemblyName>HapticLink.Setup</AssemblyName>
    <ApplicationIcon>..\HapticLink.Shared\Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>HapticLink for DualSense</Product>
    <Description>HapticLink setup</Description>
    <!-- Smaller memory: no background GC thread, and the GC keeps the heap compact. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\HapticLink.Shared\*.cs" LinkBase="Shared" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The service folder (drivers\build-service.ps1 builds it into artifacts\service) ships as "service" next to the exes. -->
  <Target Name="CopyServiceToOutput" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\service\HapticLink.Service.exe')">
    <ItemGroup>
      <ServiceFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\service\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)service" />
    <Copy SourceFiles="@(ServiceFile)" DestinationFiles="@(ServiceFile->'$(OutDir)service\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyServiceToPublish" AfterTargets="Publish" Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\service\HapticLink.Service.exe')">
    <ItemGroup>
      <ServiceFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\service\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)service" />
    <Copy SourceFiles="@(ServiceFile)" DestinationFiles="@(ServiceFile->'$(PublishDir)service\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
